  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [
    "global",
    "clickhouse"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "global",
          "clickhouse"
        ],
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "const": "existing"
                  }
                }
              }
            }
          },
          "clickhouse": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "clickhouse": {
            "properties": {
              "tls": {
                "properties": {
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "existingSecret"
                ]
              }
            },
            "required": [
              "tls"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "const": "certManager"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "certManager": {
                    "properties": {
                      "issuerName": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "issuerName"
                    ]
                  }
                },
                "required": [
