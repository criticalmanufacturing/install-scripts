{
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "namePrefix": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 20,
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "platform": {
          "type": "string",
          "enum": [
            "auto",
            "openshift",
            "kubernetes"
          ]
        },
        "clusterDomain": {
          "type": "string"
        },
        "podAntiAffinity": {
          "type": "string",
          "enum": [
            "hard",
            "soft"
          ]
        },
        "nodeSelector": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "tolerations": {
          "type": "array"
        },
        "tls": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "existing",
                "certManager"
              ]
            },
            "caSecret": {
              "type": "string"
            },
            "regenerate": {
              "type": "boolean"
            },
            "validityDays": {
              "type": "integer"
            },
            "certManager": {
              "type": "object",
              "properties": {
                "issuerName": {
                  "type": "string"
                },
                "issuerKind": {
                  "type": "string"
                },
                "issuerGroup": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "kafka": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "clusterId": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "properties": {
            "passwords": {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "string"
                },
                "monitor": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingClientSecret": {
              "type": "string"
            },
            "existingMonitorSecret": {
              "type": "string"
            },
            "renewal": {
              "type": "object",
              "properties": {
                "checkIntervalSeconds": {
                  "type": "integer"
                },
                "dynamicReload": {
                  "type": "boolean"
                },
                "restartStaggerMinutes": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "heapOpts": {
          "type": "string"
        },
        "extraJvmOpts": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer"
        },
        "probes": {
          "type": "object",
          "properties": {
            "startupFailureThreshold": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "podAnnotations": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "podLabels": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "aclJob": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "memory": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "test": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "memory": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [
    "global",
    "kafka"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "global",
          "kafka"
        ],
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "const": "existing"
                  }
                }
              }
            }
          },
          "kafka": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "kafka": {
            "properties": {
              "tls": {
                "properties": {
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  },
                  "existingClientSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "existingSecret",
                  "existingClientSecret"
                ]
              }
            },
            "required": [
              "tls"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "mode": {
                    "const": "certManager"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "properties": {
              "tls": {
                "properties": {
                  "certManager": {
                    "properties": {
                      "issuerName": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "issuerName"
                    ]
                  }
                },
                "required": [
                  "certManager"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
