{
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "namePrefix": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 20,
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "platform": {
          "type": "string",
          "enum": [
            "auto",
            "openshift",
            "kubernetes"
          ]
        },
        "clusterDomain": {
          "type": "string"
        },
        "podAntiAffinity": {
          "type": "string",
          "enum": [
            "hard",
            "soft"
          ]
        },
        "nodeSelector": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "tolerations": {
          "type": "array"
        },
        "tls": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "existing",
                "certManager"
              ]
            },
            "caSecret": {
              "type": "string"
            },
            "regenerate": {
              "type": "boolean"
            },
            "validityDays": {
              "type": "integer"
            },
            "certManager": {
              "type": "object",
              "properties": {
                "issuerName": {
                  "type": "string"
                },
                "issuerKind": {
                  "type": "string"
                },
                "issuerGroup": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "observability": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "insecureSkipVerify": {
              "type": "boolean"
            },
            "ca": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "resourceAttributes": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "replicas": {
          "type": "integer"
        },
        "scrapeInterval": {
          "type": "string"
        },
        "kafkaProtocolVersion": {
          "type": "string"
        },
        "otlpSignals": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "boolean"
            },
            "traces": {
              "type": "boolean"
            },
            "logs": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "memoryLimiter": {
          "type": "object",
          "properties": {
            "limitPercentage": {
              "type": "integer"
            },
            "spikeLimitPercentage": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "logLevel": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "nodeSelector": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "podAnnotations": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "podLabels": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "service": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "required": [
    "global",
    "observability"
  ]
}
